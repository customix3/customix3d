# ─── Firebase (required for live Auth / Firestore / Storage) ───
# Create a project at https://console.firebase.google.com
# Enable: Authentication (Email/Password), Firestore, Storage
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Without these keys the app runs in DEMO mode (local auth + demo products).

# ─── Payment gateway (later) ───
VITE_PAYMENT_GATEWAY_KEY=
VITE_PAYMENT_GATEWAY_SECRET=
