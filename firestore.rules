rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMP: open product/order writes so local admin (no Firebase Auth) can sync across devices.
    // Tighten later with isAdmin() after Firebase Auth admin users are set up.

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    match /customOrders/{id} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /offers/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
